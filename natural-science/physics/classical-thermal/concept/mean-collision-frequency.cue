package concept

mean_collision_frequency: {
  content: #"""
    *Mean collision frequency* $f$ is the average number of collisions a molecule
    undergoes per unit time. For identical molecules with a Maxwellian velocity
    distribution, the derivation in #link(<concept-mean-free-path>)[mean free path]
    gives:

    $ f = sqrt(2) n σ ⟨v⟩ $

    Here $n$ is the number of molecules per unit volume, $σ$ is the collision
    cross-section, and $⟨v⟩$ is the mean molecular speed.
  """#
  related: [
    "concept/mean-free-path"
  ]
}
